# Lidarr Configuration
LIDARR_URL=http://localhost:8686
LIDARR_API_KEY=your_lidarr_api_key_here

# MusicBrainz Configuration
CONTACT_EMAIL=your_email@example.com

# Optional: Basic auth protection
# AUTH_PASSWORD=your_password_here
# AUTH_USER=admin

# Optional: Plex authentication
# Set PLEX_AUTH=true to enable "Sign in with Plex" on the login page.
# PLEX_SERVER_ID restricts login to users who have access to a specific
# Plex server (use the server's Machine Identifier from Settings > Troubleshooting).
# PLEX_AUTH=true
# PLEX_SERVER_ID=your_plex_server_machine_id

# Optional: Enable debug logging
DEBUG=false
